# Environment Variables for ForgeGym
# Copy this file to .env and fill in the values

# Application
NODE_ENV=production
PORT=3000

# Auth
AUTH_SECRET=change-this-to-a-long-random-string

# Database (Supabase)
# The app's backend runs inside Next.js API routes, but the database itself
# must be hosted on Supabase or another PostgreSQL provider.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Global Gym Music Player
# IMPORTANT: these vars are SERVER-ONLY. Do NOT prefix with NEXT_PUBLIC_ —
# provider credentials must never reach the browser bundle. Playback state is
# browser-local; only the approved catalog + resolved stream URLs travel client.
MUSIC_PROVIDER=audius
AUDIUS_API_KEY=
